# ==============================================================================
# CAREERAI: AI CAREER INTELLIGENCE PLATFORM - API CONFIGURATION
# ==============================================================================
# NOTE: The platform is equipped with an offline-first NLP intelligence engine,
# trained Multinomial Naive Bayes classifier, custom RAG, and document parsers,
# meaning IT RUNS OUT-OF-THE-BOX EVEN WITHOUT ANY KEYS!
#
# Supplying the following keys enables live cloud features:
# ==============================================================================

# 1. GOOGLE GEMINI AI API (Recommended - Free Tier Available)
# Enables live LLM conversational reasoning, resume extraction, and mock interviews
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. OPENAI API KEY (Optional Alternative)
# Enables GPT-4o / GPT-4o-mini fine-tuned responses
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. RAPIDAPI KEY (For Live Real-World Job Search - Section 13)
# Connects to JSearch API to scrape live job postings across Google, LinkedIn, Indeed
# Get free key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# 4. SERPAPI KEY (For Live Web & Course Search - Section 13)
# Live Google Search for newly published Coursera/edX courses, tutorials, and documentation
# Get free key (100 free searches/mo) at: https://serpapi.com/
SERPAPI_API_KEY=

# 5. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
